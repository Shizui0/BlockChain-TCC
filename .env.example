# Copie este arquivo para .env e gere valores novos. Nunca use estes textos como segredo.
PORT=4173
NODE_ENV=development
DATABASE_PATH=backend/data/medchain.sqlite
UPLOAD_DIRECTORY=backend/data/uploads
MAX_UPLOAD_BYTES=10485760
FRONTEND_ORIGIN=http://localhost:4173
SEED_DEMO=true
MEDCHAIN_KEY_VERSION=v1
MEDCHAIN_PACKAGE_MAX_BYTES=10485760

# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MEDCHAIN_MASTER_KEY=SUBSTITUA_POR_32_BYTES_EM_BASE64

# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO
