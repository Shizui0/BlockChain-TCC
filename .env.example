# Copie este arquivo para .env e gere valores novos. Nunca use estes textos como segredo.
PORT=4173
NODE_ENV=development
DATABASE_PATH=backend/data/medchain.sqlite
UPLOAD_DIRECTORY=backend/data/uploads
MAX_UPLOAD_BYTES=10485760
FRONTEND_ORIGIN=http://localhost:4173
SEED_DEMO=true
MEDCHAIN_KEY_VERSION=v1
# Chaves antigas do banco (opcional): objeto JSON {"v1":"BASE64_DA_CHAVE_ANTIGA"}.
# MEDCHAIN_PREVIOUS_MASTER_KEYS={"v1":"SUBSTITUA_PELA_CHAVE_ANTIGA"}
MEDCHAIN_PACKAGE_MAX_BYTES=10485760

# Chave independente para exportar/abrir pacotes .medchain. Gere com npm run medchain:keygen.
MEDCHAIN_TRANSFER_KEY=SUBSTITUA_POR_OUTROS_32_BYTES_EM_BASE64
MEDCHAIN_TRANSFER_KEY_ID=transfer-v1
# Para leitura de pacotes antigos após rotação, sem guardar segredos no pacote:
# MEDCHAIN_TRANSFER_PREVIOUS_KEYS={"transfer-v0":"SUBSTITUA_PELA_CHAVE_ANTIGA"}

# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MEDCHAIN_MASTER_KEY=SUBSTITUA_POR_32_BYTES_EM_BASE64

# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO
